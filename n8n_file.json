    {
      "parameters": {
        "jsCode": "const msg = $json.conversation;\nconst estado = $json.estado_anterior || 'Menu_Principal';\nconst nome = $json.pushName || 'cliente';\n\n// Definimos os textos, próximos estados e a rota para o Switch\nconst menus = {\n    'Menu_Principal': {\n        '1': { \n            txt: `(menu 1) Olá, ${nome}! Tudo bem? O que gostaria de fazer?\\n\\n1️⃣ - Minhas faturas e Boletos\\n2️⃣ - Boletos Vencidos\\n3️⃣ - Atualizar meus dados\\n0️⃣ - Voltar\\n\\nPor favor, digite apenas o número.`,\n            prox: 'Faturas',\n            rota: 'ir_faturas' // Saída padrão do Switch\n        },\n        '2': { \n            txt: `⚠️ *Bifinance - Boletos Vencidos*\\n${nome}, estamos localizando seus débitos pendentes...`,\n            prox: 'Boletos_vencidos',\n            rota: 'ir_vencidos' // Saída padrão do Switch\n        },\n        '3': {\n            txt: `👤 *Atualizar Dados*\\n${nome}, escolha o que deseja alterar...`,\n            prox: 'Atualiza_Dados',\n            rota: 'ir_dados' // Saída padrão do Switch\n        }\n    },\n    'Faturas': {\n        '1': { \n            txt: \"Gerando seu boleto... Aguarde.\", \n            prox: 'Faturas', \n            rota: 'gerar_boleto' // Essa cairia na Saída 2 do seu Switch!\n        },\n        '0': { \n            txt: \"Voltando ao Menu Principal... Como posso ajudar?\", \n            prox: 'Menu_Principal',\n            rota: 'voltar'\n        }\n    }\n};\n\n// Lógica de seleção\nconst selecao = (menus[estado] && menus[estado][msg]) \n    ? menus[estado][msg] \n    : { \n        txt: \"❌ Opção inválida. Digite apenas o número correspondente.\", \n        prox: estado,\n        rota: 'fallback' // Essa cai na Saída 1 do seu Switch!\n      };\n\nreturn {\n    ...$json,\n    mensagem_texto: selecao.txt,\n    proximo_estado: selecao.prox,\n    rota_destino: selecao.rota // O Switch lê exatamente este campo aqui\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        640
      ],
      "id": "872a4566-1286-4c2c-bc59-c5488dc72651",
      "name": "Code in JavaScript1"
    },
