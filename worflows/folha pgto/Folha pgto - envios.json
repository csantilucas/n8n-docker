    {
      "parameters": {
        "jsCode": "const hoje = new Date();\nconst diaDoMes = hoje.getDate();\n\n// 1. Verifica se está na primeira semana do mês (Dias 1 a 7)\nconst isPrimeiraSemana = diaDoMes <= 7;\n\n// 2. Verifica se está na última semana do mês\nconst amanha = new Date(hoje.getFullYear(), hoje.getMonth() + 1, 0);\nconst ultimoDiaDoMes = amanha.getDate();\nconst isUltimaSemana = (ultimoDiaDoMes - diaDoMes) < 7;\n\n// Se estiver em uma das duas janelas, permite a execução\nif (isPrimeiraSemana || isUltimaSemana) {\n  return [{ json: { executar: true, motivo: isPrimeiraSemana ? \"Primeira semana do mês\" : \"Última semana do mês\" } }];\n}\n\n// Se não estiver na janela de dias, retorna um array vazio (o n8n para o fluxo aqui)\nreturn [];"
      },
