    {
      "parameters": {
        "jsCode": "const item = $input.item;\nconst name = $input.first().json.nome;\nconst data = $input.first().json.data;\n\nlet base64Data = item.json.pdf_base64; \nconst fileName = item.json.nome_arquivo || `recibo ${name}, ${data}.pdf`;\n\n\nif (base64Data && base64Data.includes(',')) {\n  base64Data = base64Data.split(',')[1];\n}\n\nreturn [{\n  json: item.json,\n  binary: {\n    data: {\n      data: base64Data,\n      mimeType: 'application/pdf',\n      fileName: fileName,\n      fileExtension: 'pdf',\n      encoding: 'base64' \n    }\n  }\n}];"
      },
